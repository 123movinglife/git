server:
  port: 8080

spring:
  application:
    name: market
  datasource:
    url: jdbc:mysql://localhost:3306/campus_market?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
    username: your_username
    password: your_password
    driver-class-name: com.mysql.cj.jdbc.Driver
  data:
    redis:
      host: localhost
      port: 6379

mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

jwt:
  # 至少 32 字符，生产环境请更换为你自己的随机字符串
  secret: change-this-to-your-own-secret-key-at-least-32-chars
  expire: 604800000
